VITE_APP_NAME="${APP_NAME}"

# Docker
CONTAINER_LABEL="portfolio"
WEB_PORT_HTTP=8080
WEB_PORT_SSL=8443
MYSQL_VERSION=8.3
PHPMYADMIN_VERSION=5.2.1
